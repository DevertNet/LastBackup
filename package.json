{
  "name": "lastbackup",
  "version": "0.0.0-development",
  "description": "",
  "source": "src/frontend/index.html",
  "scripts": {
    "start": "parcel src/frontend/index.html",
    "build": "rm -rf .dist && NODE_ENV=production parcel build src/frontend/index.html --dist-dir .dist/public --no-cache",
    "build-api": "cp -R api .dist/public/api && cp -R vendor .dist/vendor && mkdir -p .dist/src && cp -R src/api .dist/src/api",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DevertNet/LastBackup.git"
  },
  "author": "Leon Weickert <node@devert.net> (https://devert.net/)",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/DevertNet/LastBackup/issues"
  },
  "homepage": "https://github.com/DevertNet/LastBackup#readme",
  "dependencies": {
    "bootstrap": "^5.3.9",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "sjcl": "^1.0.9"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sjcl": "^1.0.34",
    "bootswatch": "^5.3.8",
    "parcel": "^2.16.4",
    "sass": "^1.108.2",
    "typescript": "^7.0.2"
  }
}
